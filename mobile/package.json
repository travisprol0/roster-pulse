{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.0",
    "expo": "~57.0.22",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "bash scripts/expo-web.sh",
    "test": "jest --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "App.js",
      "src/**/*.{js,jsx}",
      "!src/**/__tests__/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "json",
      "lcov"
    ]
  },
  "private": true
}
